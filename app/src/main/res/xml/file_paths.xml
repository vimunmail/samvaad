<?xml version="1.0" encoding="utf-8"?>
<!--
  Paths the app's FileProvider is allowed to share with other apps (WhatsApp,
  Gmail, Drive, …). Conversation transcripts are written to cacheDir/exports
  before being handed to the Android share sheet.
-->
<paths>
    <cache-path name="exports" path="exports/" />
    <external-cache-path name="external_exports" path="exports/" />
    <!-- Saved transcripts and authentication data are never shareable paths.
         Explicit transcript exports use only cacheDir/exports above. -->
    <!-- File Manager sharing: trained models and recorded CSV datasets. -->
    <external-files-path name="models" path="models/" />
    <external-files-path name="datasets" path="TelemetryData/" />
    <!-- System-voice gesture audio clips (.m4a) shared from the chat. -->
    <files-path name="gesture_audio" path="gesture_audio/" />
</paths>
