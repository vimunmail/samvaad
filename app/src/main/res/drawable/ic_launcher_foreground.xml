<?xml version="1.0" encoding="utf-8"?>
<!--
  GESTALK launcher icon foreground — vector recreation of the brand logo:
  green stop-sign octagon with a white inset border, a white open hand,
  and a black-outlined speech bubble with three dots at the top right.
  Everything stays inside the 66dp adaptive-icon safe zone (radius 33
  around 54,54) so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Green octagon (circumradius 30) -->
    <path
        android:fillColor="#00A651"
        android:pathData="M81.72,42.52 L81.72,65.48 L65.48,81.72 L42.52,81.72 L26.28,65.48 L26.28,42.52 L42.52,26.28 L65.48,26.28 Z" />

    <!-- White inset border ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:pathData="M78.48,43.86 L78.48,64.14 L64.14,78.48 L43.86,78.48 L29.52,64.14 L29.52,43.86 L43.86,29.52 L64.14,29.52 Z" />

    <!-- Hand: palm -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M37.5,56 L64.5,56 L64.5,64.5 C64.5,72.5 58.5,76.5 52.5,76.5 L49,76.5 C42.5,76.5 37.5,71.5 37.5,64.5 Z" />
    <!-- Hand: four fingers (round-capped strokes; middle tallest).
         2.2-unit gaps between strokes so fingers stay distinct at 48dp. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:pathData="M41.2,57 L41.2,43" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:pathData="M48,57 L48,39" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:pathData="M54.8,57 L54.8,41" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:pathData="M61.6,57 L61.6,46.5" />
    <!-- Hand: thumb sweeping out to the left -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M38.5,64 C34.5,60 32.5,54.5 33,49" />

    <!-- Speech bubble (white with black outline + tail) -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#111111"
        android:strokeWidth="2"
        android:strokeLineJoin="round"
        android:pathData="M59,35.5 C59,31.1 63.5,27.5 69,27.5 C74.5,27.5 79,31.1 79,35.5 C79,39.9 74.5,43.5 69,43.5 L64.5,43.5 L60,47 L62,42.6 C60.1,41 59,38.4 59,35.5 Z" />
    <!-- Three typing dots -->
    <path
        android:fillColor="#111111"
        android:pathData="M64,35.5 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0" />
    <path
        android:fillColor="#111111"
        android:pathData="M69,35.5 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0" />
    <path
        android:fillColor="#111111"
        android:pathData="M74,35.5 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0" />
</vector>
