{
  "name": "gestalk-qr-tools",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "web:dev": "npm --prefix guest-chat run dev",
    "web:build": "node scripts/sync-chat-assets.mjs && npm --prefix guest-chat run build",
    "test:rules": "firebase emulators:exec --project demo-gestalk --only firestore \"node --test firebase/tests/*.test.mjs\"",
    "firebase:login": "firebase login --no-localhost",
    "firebase:configure": "node scripts/configure-firebase.mjs",
    "firebase:deploy": "npm run web:build && firebase deploy --only firestore:rules,hosting"
  },
  "overrides": { "@grpc/grpc-js": "1.14.5", "basic-ftp": "6.2.2", "gaxios": { "uuid": "11.1.1" } },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1"
  }
}
